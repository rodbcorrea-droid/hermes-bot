# =============================================================================
# Brandão Correa Assessoria Jurídica — Bot Hermes
# Arquivo de configuração de ambiente (.env.example)
# Copie este arquivo para .env e preencha com os valores reais.
# =============================================================================

# ---------------------------------------------------------------------------
# Telegram Bot
# ---------------------------------------------------------------------------
# Token do bot obtido via @BotFather no Telegram
TELEGRAM_BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Token secreto opcional para validar webhooks (altamente recomendado).
# Gerar com: openssl rand -hex 32
# Configurar no setWebhook via Bot API: ?secret_token=<valor>
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# ---------------------------------------------------------------------------
# Bitrix24 CRM — REST API
# ---------------------------------------------------------------------------
# Domínio do seu portal Bitrix24 (sem https:// e sem barra final)
BITRIX24_DOMAIN=seuportal.bitrix24.com.br

# Webhook de entrada (Inbound Webhook)
BITRIX24_USER_ID=1
BITRIX24_WEBHOOK_TOKEN=seu_webhook_token_aqui

# ID do Canal Aberto (Open Channel) configurado no Bitrix24
BITRIX24_OPEN_CHANNEL_ID=1

# ID interno da operadora Alice no Bitrix24 (user ID)
BITRIX24_OPERATOR_ALICE_ID=1

# Campo customizado de CPF no Bitrix24.
# Descubra o ID real via: crm.contact.fields → procurar por campo de CPF
# Padrão usual: UF_CRM_<ID_NUMERICO> (ex: UF_CRM_1234567890)
BITRIX24_CPF_CUSTOM_FIELD=UF_CRM_CPF

# Funil e estágio padrão para novos negócios criados pelo bot
BITRIX24_DEAL_CATEGORY_ID=0
BITRIX24_DEAL_STAGE_NEW=NEW

# Slug da página pública de agendamento (Booking)
# URL final: https://{domain}/pub/{slug}/
BITRIX24_BOOKING_SLUG=booking

# ---------------------------------------------------------------------------
# Hermes IA — NLP / LLM (OpenAI, Anthropic ou compatível)
# ---------------------------------------------------------------------------
# Provedor: openai | anthropic | custom
HERMES_AI_PROVIDER=openai

# Chave da API do provedor de LLM
HERMES_AI_API_KEY=

# Modelo a ser utilizado (ex: gpt-4o-mini, claude-haiku-4-5)
HERMES_AI_MODEL=gpt-4o-mini

# URL base customizada (opcional — para proxies ou endpoints self-hosted)
# Deixe vazio para usar o endpoint padrão do provedor
HERMES_AI_BASE_URL=

# Nem todo provedor OpenAI-compatível suporta response_format json_object.
# Setar false para Ollama, vLLM, LM Studio, etc.
HERMES_AI_SUPPORTS_JSON_MODE=true

# Timeout em ms para chamadas de IA
HERMES_AI_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Servidor Express
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Header HTTP para propagar requestId (default: X-Request-Id)
REQUEST_ID_HEADER=X-Request-Id

# ---------------------------------------------------------------------------
# Sessões
# ---------------------------------------------------------------------------
# Backend: 'memory' (default) | 'redis' (futuro)
SESSION_BACKEND=memory

# TTL em minutos — sessões expiram após N minutos de inatividade
SESSION_TTL_MINUTES=30

# Máximo de mensagens mantidas no histórico por sessão
SESSION_HISTORY_LIMIT=50

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
# Telegram — NÃO limitar agressivamente (Telegram reenvia webhooks)
RATE_LIMIT_TG_WINDOW_MS=60000
RATE_LIMIT_TG_MAX=600

# Bitrix24 — webhooks de eventos reversos (mais restritivo)
RATE_LIMIT_BX_WINDOW_MS=60000
RATE_LIMIT_BX_MAX=60

# ---------------------------------------------------------------------------
# Retry (chamadas HTTP para Bitrix24 / IA)
# ---------------------------------------------------------------------------
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=500

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Nível: debug | info | warn | error
LOG_LEVEL=info

# Formato: 'plain' (console legível) | 'json' (pino-style para Datadog/Loki)
LOG_FORMAT=plain

# ---------------------------------------------------------------------------
# Contingência (fallback)
# ---------------------------------------------------------------------------
# Telefone/WhatsApp de contingência exibido ao cliente em caso de falha
FALLBACK_PHONE=(65) 99679-4931
